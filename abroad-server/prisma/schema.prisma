// Ultra settles the BUY and the vault withdrawal as two independent money
// movements, so the batch walks both stages instead of one submitted/credited
// pair: OPEN -> BOUGHT (trade settled, crypto held at Transfero) -> WITHDRAWN
// (vault withdrawal accepted) -> CREDITED (landed in Abroad custody).
enum TreasuryReplenishStatus {
  OPEN
  BOUGHT
  WITHDRAWN
  CREDITED
  FAILED
}

enum QuoteRequestDirection {
  FORWARD
  REVERSE
}

enum QuoteRequestOutcome {
  PENDING
  SUCCESS
  FAILED
}

enum EconomicConversionStatus {
  PENDING
  SETTLED
  FAILED
  NOT_APPLICABLE
}

enum EconomicFactCoverageStatus {
  PENDING
  COMPLETE
  UNAVAILABLE
}

enum TransactionEconomicCostKind {
  PAYOUT_PROVIDER_FEE
  BRIDGE_FEE
  BLOCKCHAIN_FEE
  REFUND_FEE
}

enum TransactionEconomicCostStatus {
  PENDING
  CONFIRMED
  UNAVAILABLE
  VOID
}

// One PII-free event per quote HTTP request. Successful Quote rows remain the
// authoritative success ledger; this table supplies the otherwise-unpersisted
// failed-request side and an explicit ingestion-coverage boundary.
model QuoteRequestMetric {
  id          String                @id @default(uuid())
  direction   QuoteRequestDirection
  outcome     QuoteRequestOutcome   @default(PENDING)
  statusCode  Int?
  requestedAt DateTime              @default(now())
  completedAt DateTime?

  @@index([requestedAt, outcome])
}

// Singleton reconciliation watermark and quote-metric coverage boundary.
model BusinessPerformanceState {
  id                  String    @id @default("singleton")
  quoteMetricsFrom    DateTime?
  lastReconciledAt    DateTime?
  backfillCompletedAt DateTime?
  updatedAt           DateTime  @updatedAt
}

// Exact transaction-level economics. Source stablecoins are nominal USD;
// payout/proceeds stay in their native settlement currency and are converted
// transaction-by-transaction with the locked rate below.
model TransactionEconomics {
  transactionId             String                     @id
  transaction               Transaction                @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  sourceCurrency            CryptoCurrency
  sourceAmountUsd           Decimal                    @db.Decimal(36, 18)
  payoutCurrency            TargetCurrency
  customerPayoutNative      Decimal                    @db.Decimal(36, 18)
  conversionProvider        String?
  providerOperationId       String?                    @unique
  conversionStatus          EconomicConversionStatus   @default(PENDING)
  proceedsCoverage          EconomicFactCoverageStatus @default(PENDING)
  lockedRateNativePerUsd    Decimal?                   @db.Decimal(36, 18)
  providerProceedsNative    Decimal?                   @db.Decimal(36, 18)
  proceedsUnavailableReason String?
  settledAt                 DateTime?
  lastReconciledAt          DateTime?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  costs                     TransactionEconomicCost[]

  @@index([conversionStatus, settledAt])
  @@index([lastReconciledAt])
  @@index([payoutCurrency, conversionStatus])
}

// A transaction can incur multiple independently reconcilable costs. The
// operation key is stable across retries and status transitions, preventing a
// duplicated financial cost from entering the report.
model TransactionEconomicCost {
  id             String                        @id @default(uuid())
  transactionId  String
  economics      TransactionEconomics          @relation(fields: [transactionId], references: [transactionId], onDelete: Cascade)
  kind           TransactionEconomicCostKind
  operationKey   String
  status         TransactionEconomicCostStatus @default(PENDING)
  nativeAmount   Decimal?                      @db.Decimal(36, 18)
  nativeCurrency String?
  usdRate        Decimal?                      @db.Decimal(36, 18)
  usdAmount      Decimal?                      @db.Decimal(36, 18)
  reasonCode     String?
  observedAt     DateTime?
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt

  @@unique([transactionId, kind, operationKey])
  @@index([kind, status, observedAt])
  @@index([transactionId, status])
}

// One per ENQUEUE_BRIDGE step: the USDC a flow deposited at Binance that still
// owes a cross-chain bridge to Transfero. Accumulated across flows and swept to
// Transfero in batches >= the per-withdrawal minimum (the flow itself settles
// immediately by converting against the Transfero float — see ENQUEUE_BRIDGE).
model BridgePendingTransfer {
  id            String          @id @default(uuid())
  transactionId String
  stepOrder     Int
  asset         CryptoCurrency
  destNetwork   String
  amount        Float
  status        BridgeLegStatus @default(PENDING)
  batchId       String?
  batch         BridgeBatch?    @relation(fields: [batchId], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // (transactionId, stepOrder) is the idempotency anchor: re-running the
  // ENQUEUE_BRIDGE step never double-enrolls a leg.
  @@unique([transactionId, stepOrder])
  @@index([asset, destNetwork, status])
  @@index([batchId])
}

// One pooled Binance withdrawal that bridges many BridgePendingTransfer legs.
model BridgeBatch {
  id          String                  @id @default(uuid())
  asset       CryptoCurrency
  destNetwork String
  grossAmount Float
  withdrawFee Float?
  withdrawId  String?
  status      BridgeBatchStatus       @default(OPEN)
  members     BridgePendingTransfer[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  settledAt   DateTime?

  @@index([asset, destNetwork, status])
}

// A FIAT_TO_CRYPTO transaction has already paid its customer from Abroad's hot
// wallet; this records the BRL that landed at Transfero and still owes the hot
// wallet a top-up. Enrolment is the only thing the customer flow does — nothing
// here can block or reverse a delivery that already settled on chain.
model TreasuryReplenishRequest {
  id            String                  @id @default(uuid())
  transactionId String
  stepOrder     Int
  // BRL credited at Transfero by the customer's PIX, and the asset/network the
  // hot wallet paid out and must be topped back up on.
  fiatAmount    Float
  fiatCurrency  TargetCurrency
  asset         CryptoCurrency
  destNetwork   BlockchainNetwork
  status        ReplenishLegStatus      @default(PENDING)
  batchId       String?
  batch         TreasuryReplenishBatch? @relation(fields: [batchId], references: [id])
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  // (transactionId, stepOrder) is the idempotency anchor: re-running the
  // ENQUEUE_TREASURY_REPLENISH step never double-enrolls a leg.
  @@unique([transactionId, stepOrder])
  @@index([asset, destNetwork, status])
  @@index([batchId])
}

// One pooled BRZ -> crypto OTC BUY plus vault withdrawal that replenishes many
// TreasuryReplenishRequest legs. Ultra never chains money movements, so each
// stage is recorded separately and reconciled before the next one starts.
model TreasuryReplenishBatch {
  id            String                     @id @default(uuid())
  asset         CryptoCurrency
  destNetwork   BlockchainNetwork
  fiatAmount    Float
  fiatCurrency  TargetCurrency
  // Bought quantity as reported by the settled trade, not as requested.
  boughtAmount  Float?
  // Ultra OTC trade id, then the vault withdrawal id. Persisted before each
  // call is considered complete so an ambiguous response reconciles read-only.
  tradeId       String?
  withdrawalId  String?
  withdrawFee   Float?
  status        TreasuryReplenishStatus    @default(OPEN)
  failureReason String?
  members       TreasuryReplenishRequest[]
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  settledAt     DateTime?

  @@unique([tradeId])
  @@unique([withdrawalId])
  @@index([asset, destNetwork, status])
}

// Point-in-time balance of one (venue, account, currency) cell, captured by the
// treasury snapshot worker. usdRate/usdValue freeze the indicative FX at capture
// time so historical USD charts do not drift when today's rate changes.
model TreasuryBalanceSnapshot {
  id                String   @id @default(uuid())
  venue             String
  account           String   @default("")
  currency          String
  amount            Float
  availableAmount   Float?
  blockedAmount     Float?
  reservedAmount    Float?
  outstandingAmount Float?
  usdRate           Float?
  usdValue          Float?
  capturedAt        DateTime @default(now())

  @@index([venue, currency, capturedAt])
  @@index([capturedAt])
}

// OPEN accrues yield; CLOSED is a lot we stopped holding, kept for the audit
// trail rather than deleted.
enum StablebondPositionStatus {
  OPEN
  CLOSED
}

// ACQUIRE spends the quote asset for bond tokens; UNWIND is the reverse. With no
// issuer relationship the same public venue is the only route in and the only
// route out, so both sides share one ledger and one set of safety rules.
enum StablebondExecutionDirection {
  ACQUIRE
  UNWIND
}

// QUOTED -> SUBMITTED -> CONFIRMED is the happy path. The row exists at QUOTED,
// before the venue is ever asked to execute, so an execution that never returns
// can be reconciled by hash instead of re-executed. AMBIGUOUS is the state that
// must never be retried blindly.
enum StablebondExecutionStatus {
  QUOTED
  SUBMITTED
  CONFIRMED
  FAILED
  AMBIGUOUS
}

// An Etherfuse Stablebond position held as a trustline on one treasury venue.
//
// The token balance itself is on chain and is always read from the chain — it is
// deliberately NOT mirrored here, because a mirrored balance is a reconciliation
// liability. What the chain cannot tell us is the cost basis, and without a basis
// there is no way to attribute yield to a timestamp. That is what this row owns.
model StablebondPosition {
  id              String                      @id @default(uuid())
  // Etherfuse bond symbol (TESOURO), the Stellar asset code and issuer that
  // identify the same bond on chain, and the venue holding the trustline.
  symbol          String
  assetCode       String
  issuer          String
  venue           String
  // The bond's sovereign currency (BRL for TESOURO). Yield accrues in this
  // currency, which is the point: a BRL payout float earning a BRL bond yield
  // carries no currency mismatch.
  fiatCurrency    String
  status          StablebondPositionStatus    @default(OPEN)
  // Cost basis. principalFiat is what the lot cost at entryNavFiat; accrued
  // yield is (tokens read from chain * current NAV) - principalFiat.
  principalTokens Decimal                     @db.Decimal(36, 18)
  principalFiat   Decimal                     @db.Decimal(36, 18)
  entryNavFiat    Decimal                     @db.Decimal(36, 18)
  openedAt        DateTime                    @default(now())
  closedAt        DateTime?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  executions      StablebondExecution[]

  // One lot per bond per venue. Acquiring more adjusts the basis of the existing
  // lot rather than opening a second row, so the just-in-time unwind always has
  // exactly one row to lock and can never split a position across two locks.
  @@unique([symbol, venue])
  @@index([status, symbol])
}

// One execution against the venue, in either direction: the quote that was taken,
// the slippage floor it was bounded by, and what the venue actually returned.
model StablebondExecution {
  id              String                       @id @default(uuid())
  positionId      String
  position        StablebondPosition           @relation(fields: [positionId], references: [id], onDelete: Restrict)
  direction       StablebondExecutionDirection
  // Derived from the business identifier that caused the execution, so a retried
  // caller re-attaches to the existing row instead of trading twice.
  idempotencyKey  String                       @unique
  status          StablebondExecutionStatus    @default(QUOTED)
  // What was spent, what was quoted for it, and the floor below which the venue
  // must not fill. minReceive is what actually goes on chain: it is the slippage
  // bound, enforced by the network rather than by us re-checking after the fact.
  sendAsset       String
  sendAmount      Decimal                      @db.Decimal(36, 18)
  receiveAsset    String
  quotedReceive   Decimal                      @db.Decimal(36, 18)
  minReceive      Decimal                      @db.Decimal(36, 18)
  receivedAmount  Decimal?                     @db.Decimal(36, 18)
  // NAV at quote time, so the spread actually paid stays computable long after
  // the market has moved.
  navFiatPerToken Decimal                      @db.Decimal(36, 18)
  navUsdPerToken  Decimal                      @db.Decimal(36, 18)
  // Executed price against NAV, in basis points. Positive is always the cost
  // direction: an unwind that sold below NAV, or an acquisition that paid above
  // it. That is the normal sign, and it is the price of being liquid.
  spreadBps       Int?
  // Known before submission (a Stellar transaction hash is a property of the
  // signed envelope), which is what makes reconcile-by-hash possible.
  onChainId       String?                      @unique
  failureReason   String?
  quotedAt        DateTime                     @default(now())
  settledAt       DateTime?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  @@index([positionId, quotedAt])
  @@index([direction, status, quotedAt])
}

