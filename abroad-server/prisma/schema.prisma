// prisma/schema.prisma
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Partner {
  id            String        @id @default(uuid())
  name          String
  createdAt     DateTime      @default(now())
  apiKey        String?       @unique
  clientDomain  String?       @unique
  clientDomainHash String?      @unique
  country       String?
  email         String?       @unique
  phone         String?
  firstName     String?
  lastName      String?
  isKybApproved Boolean?      @default(false)
  needsKyc      Boolean?      @default(true)
  webhookUrl    String?
  users         PartnerUser[]
  portalUsers   PartnerPortalUser[]
  portalApiKeys        PartnerApiKey[]
  portalAuditEvents    PartnerPortalAuditEvent[]
  webhookConfiguration PartnerWebhookConfiguration?
  outboxEvents         OutboxEvent[]
  reconciliationRuns   PartnerReconciliationRun[]
  quotes        Quote[]
}

model PartnerPortalUser {
  id                  String   @id @default(uuid())
  partnerId           String
  partner             Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  email               String   @unique
  passwordVerifier           String?
  role                       PartnerPortalRole                 @default(MEMBER)
  sessionVersion      Int      @default(1)
  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  disabledAt          DateTime?
  mfaSecretCiphertext        String?
  mfaPendingSecretCiphertext String?
  mfaPendingCreatedAt        DateTime?
  mfaEnabledAt               DateTime?
  mfaLastUsedCounter         BigInt?
  mfaFailedAttempts          Int                               @default(0)
  mfaLockedUntil             DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  createdApiKeys             PartnerApiKey[]                   @relation("PartnerApiKeyCreator")
  auditEvents                PartnerPortalAuditEvent[]         @relation("PartnerPortalAuditActor")
  createdResetTokens         PartnerPortalPasswordResetToken[] @relation("PartnerPortalPasswordResetCreator")
  resetTokens                PartnerPortalPasswordResetToken[] @relation("PartnerPortalPasswordResetSubject")
  mfaRecoveryCodes           PartnerPortalMfaRecoveryCode[]
  initiatedOutboxEvents      OutboxEvent[]                     @relation("OutboxPortalInitiator")
  reconciliationRuns         PartnerReconciliationRun[]        @relation("PartnerReconciliationInitiator")

  @@index([partnerId])
}

model PartnerApiKey {
  id              String               @id @default(uuid())
  partnerId       String
  partner         Partner              @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  name            String
  secretHash      String               @unique
  displayPrefix   String
  scopes          PartnerApiKeyScope[]
  expiresAt       DateTime?
  revokedAt       DateTime?
  lastUsedAt      DateTime?
  createdByUserId String
  createdBy       PartnerPortalUser    @relation("PartnerApiKeyCreator", fields: [createdByUserId], references: [id])
  rotatedFromId   String?              @unique
  rotatedFrom     PartnerApiKey?       @relation("PartnerApiKeyRotation", fields: [rotatedFromId], references: [id], onDelete: SetNull)
  rotatedTo       PartnerApiKey?       @relation("PartnerApiKeyRotation")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([partnerId, revokedAt, expiresAt])
}

model PartnerWebhookConfiguration {
  partnerId               String    @id
  partner                 Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  activeSecretCiphertext  String?
  activeSecretPrefix      String?
  activeSecretVersion     Int       @default(0)
  pendingUrl              String?
  pendingSecretCiphertext String?
  pendingSecretPrefix     String?
  pendingRevision         Int       @default(0)
  lastTestedRevision      Int?
  lastTestedAt            DateTime?
  lastTestSucceeded       Boolean?
  lastTestHttpStatus      Int?
  lastTestDurationMs      Int?
  lastTestFailureCode     String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model PartnerPortalMfaRecoveryCode {
  id         String            @id @default(uuid())
  userId     String
  user       PartnerPortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String            @unique
  consumedAt DateTime?
  createdAt  DateTime          @default(now())

  @@index([userId, consumedAt])
}

model PartnerPortalPasswordResetToken {
  id              String                            @id @default(uuid())
  userId          String
  user            PartnerPortalUser                 @relation("PartnerPortalPasswordResetSubject", fields: [userId], references: [id], onDelete: Cascade)
  createdByUserId String?
  createdBy       PartnerPortalUser?                @relation("PartnerPortalPasswordResetCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  tokenHash       String                            @unique
  purpose         PartnerPortalPasswordResetPurpose
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime                          @default(now())

  @@index([userId, expiresAt])
}

model PartnerPortalAuditEvent {
  id           String             @id @default(uuid())
  partnerId    String
  partner      Partner            @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  actorUserId  String?
  actor        PartnerPortalUser? @relation("PartnerPortalAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  createdAt    DateTime           @default(now())

  @@index([partnerId, createdAt])
}

model PartnerUser {
  id               String           @id @default(uuid())
  partnerId        String
  partner          Partner          @relation(fields: [partnerId], references: [id])
  userId           String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  transaction      Transaction[]
  kyc              PartnerUserKyc[]
  kycExternalToken String?

  // Account disable/enable (operator action from the Ops dashboard).
  // disabledAt == null means the user is enabled.
  disabledAt     DateTime?
  disabledReason String?
  disabledBy     String?

  // Unique constraint to ensure a user is only once per partner
  @@unique([partnerId, userId])
}

model PartnerUserKyc {
  id            String      @id @default(uuid())
  partnerUser   PartnerUser @relation(fields: [partnerUserId], references: [id])
  partnerUserId String

  status KycStatus @default(PENDING)

  // Self-service KYC form fields (auto-approved on complete submission).
  fullName          String?
  documentType      DocumentType?
  documentNumber    String?
  documentImagePath String? // GCS object key for the uploaded ID image
  dateOfBirth       DateTime?
  nationality       String?
  city              String?
  address           String?
  email             String?
  phone             String?
  reviewedAt        DateTime?

  // Deprecated Persona fields (kept nullable for historical rows; no longer written).
  externalId String?
  tier       KYCTier @default(NONE)
  link       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([partnerUserId, externalId])
}

model Quote {
  id             String            @id @default(uuid())
  targetAmount   Float
  sourceAmount   Float
  targetCurrency TargetCurrency
  paymentMethod  PaymentMethod
  country        Country
  cryptoCurrency CryptoCurrency
  network        BlockchainNetwork

  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id])

  expirationDate DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  transaction    Transaction?

  @@index([partnerId])
}

model Transaction {
  id            String            @id @default(uuid())
  partnerUserId String
  partnerUser   PartnerUser       @relation(fields: [partnerUserId], references: [id])
  accountNumber String
  bankCode      String            @default("")
  status        TransactionStatus
  createdAt     DateTime          @default(now())
  quoteId       String            @unique
  quote         Quote             @relation(fields: [quoteId], references: [id])
  onChainId     String?           @unique
  refundOnChainId String?         @unique
  pixEndToEndId String?           @unique
  taxId         String?
  externalId    String?           @unique
  qrCode        String?
  exchangeHandoffAt DateTime?
  origin        TransactionOrigin @default(LEGACY)
  transitions   TransactionTransition[]
  outboxEvents        OutboxEvent[]
  reconciliationItems PartnerReconciliationItem[]

  @@index([partnerUserId, status, createdAt], name: "transaction_partnerUser_status_createdAt_idx")
}

model StellarListenerState {
  id              String   @id @default("singleton")
  lastPagingToken String
  updatedAt       DateTime @updatedAt
}

model SolanaListenerState {
  id                String    @id
  lastSignature     String?
  lastProcessedTime DateTime?
  lastProcessedSlot Int
}

model StellarOrphanRefund {
  paymentId           String             @id
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  lastError           String?
  reason              String?
  refundTransactionId String?
  status              OrphanRefundStatus
}

model PendingConversions {
  source SupportedCurrency
  target SupportedCurrency
  amount Float
  symbol String
  side   OrderSide

  @@id([source, target])
}

model TransactionTransition {
  id             String            @id @default(uuid())
  transactionId  String
  transaction    Transaction       @relation(fields: [transactionId], references: [id])
  event          String
  fromStatus     TransactionStatus
  toStatus       TransactionStatus
  idempotencyKey String
  context        Json?
  createdAt      DateTime          @default(now())

  @@unique([transactionId, idempotencyKey])
  @@index([transactionId, createdAt])
}

enum OutboxStatus {
  PENDING
  DELIVERING
  DELIVERED
  FAILED
}

model OutboxEvent {
  id           String       @id @default(uuid())
  type         String
  payload      Json
  status       OutboxStatus @default(PENDING)
  attempts     Int          @default(0)
  lastError    String?
  partnerId               String?
  partner                 Partner?                @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  transactionId           String?
  transaction             Transaction?            @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  webhookEvent            String?
  webhookPurpose          WebhookDeliveryPurpose?
  webhookCredentialMode   WebhookCredentialMode?
  sourceOutboxEventId     String?
  sourceOutboxEvent       OutboxEvent?            @relation("OutboxRedeliveries", fields: [sourceOutboxEventId], references: [id], onDelete: SetNull)
  redeliveries            OutboxEvent[]           @relation("OutboxRedeliveries")
  initiatedByPortalUserId String?
  initiatedByPortalUser   PartnerPortalUser?      @relation("OutboxPortalInitiator", fields: [initiatedByPortalUserId], references: [id], onDelete: SetNull)
  idempotencyKey          String?                 @unique
  maxAttempts             Int                     @default(5)
  lastHttpStatus          Int?
  lastAttemptDurationMs   Int?
  availableAt  DateTime     @default(now())
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status, availableAt])
  @@index([partnerId, transactionId, createdAt])
  @@index([sourceOutboxEventId, createdAt])
}

model PartnerReconciliationRun {
  id                      String                         @id @default(uuid())
  partnerId               String
  partner                 Partner                        @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  initiatedByPortalUserId String
  initiatedByPortalUser   PartnerPortalUser              @relation("PartnerReconciliationInitiator", fields: [initiatedByPortalUserId], references: [id])
  status                  PartnerReconciliationRunStatus @default(RUNNING)
  batchSize               Int
  cursorCreatedAt         DateTime?
  cursorTransactionId     String?
  leaseToken              String?
  leaseExpiresAt          DateTime?
  processedCount          Int                            @default(0)
  updatedCount            Int                            @default(0)
  unchangedCount          Int                            @default(0)
  ineligibleCount         Int                            @default(0)
  failureCount            Int                            @default(0)
  completedAt             DateTime?
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt
  items                   PartnerReconciliationItem[]

  @@index([partnerId, createdAt])
}

model PartnerReconciliationItem {
  id            String                          @id @default(uuid())
  runId         String
  run           PartnerReconciliationRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  transactionId String
  transaction   Transaction                     @relation(fields: [transactionId], references: [id])
  status        PartnerReconciliationItemStatus
  failureCode   String?
  createdAt     DateTime                        @default(now())
  updatedAt     DateTime                        @updatedAt

  @@unique([runId, transactionId])
  @@index([transactionId])
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
  PENDING_APPROVAL
}

enum PartnerPortalRole {
  ADMIN
  MEMBER
}

enum PartnerApiKeyScope {
  TRANSACTIONS_READ
  TRANSACTIONS_WRITE
  PARTNER_USERS_READ
  PARTNER_USERS_WRITE
  KYC_READ
  KYC_WRITE
  TELEMETRY_WRITE
}

enum PartnerPortalPasswordResetPurpose {
  INVITATION
  PASSWORD_RESET
}

enum WebhookDeliveryPurpose {
  TRANSACTION
  TEST
  REDELIVERY
}

enum WebhookCredentialMode {
  PARTNER_CURRENT
  PARTNER_PENDING
  LEGACY_ORIGIN
}

enum PartnerReconciliationRunStatus {
  RUNNING
  COMPLETED
  COMPLETED_WITH_ERRORS
}

enum PartnerReconciliationItemStatus {
  UPDATED
  UNCHANGED
  INELIGIBLE
  FAILED
}

enum DocumentType {
  NATIONAL_ID
  PASSPORT
  DRIVERS_LICENSE
  FOREIGN_ID
  OTHER
}

enum TransactionStatus {
  AWAITING_PAYMENT
  PROCESSING_PAYMENT
  PAYMENT_FAILED
  PAYMENT_EXPIRED
  PAYMENT_COMPLETED
  WRONG_AMOUNT
}

enum TransactionOrigin {
  DIRECT
  SEP_24
  LEGACY
}

enum OrderSide {
  BUY
  SELL
}

enum OrphanRefundStatus {
  PENDING
  FAILED
  SUCCEEDED
}

enum CryptoCurrency {
  USDC
  USDT
}

enum KYCTier {
  NONE
  BASIC
  STANDARD
  ENHANCED
}

enum SupportedCurrency {
  USDC
  USDT
  COP
  BRL
}

enum BlockchainNetwork {
  STELLAR
  SOLANA
  CELO
}

enum Country {
  CO
}

enum PaymentMethod {
  NEQUI // Legacy: kept for historical records only
  MOVII // Legacy: kept for historical records only
  PIX
  BREB
}

enum TargetCurrency {
  COP
  BRL
}

enum FlowPricingProvider {
  BINANCE
  TRANSFERO
}

enum FlowCorridorStatus {
  SUPPORTED
  UNSUPPORTED
}

enum FlowStepType {
  PAYOUT_SEND
  EXCHANGE_SEND
  EXCHANGE_CONVERT
  TREASURY_TRANSFER
  AWAIT_PROVIDER_STATUS
  AWAIT_EXCHANGE_BALANCE
  ENQUEUE_BRIDGE
}

enum FlowStepCompletionPolicy {
  SYNC
  AWAIT_EVENT
}

enum FlowInstanceStatus {
  NOT_STARTED
  IN_PROGRESS
  WAITING
  FAILED
  COMPLETED
}

enum FlowStepStatus {
  NOT_STARTED
  READY
  RUNNING
  WAITING
  SUCCEEDED
  FAILED
  SKIPPED
}

model PaymentProvider {
  id        String   @id
  name      String
  liquidity Float
  country   Country
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PartnerDailyLimit {
  id            String         @id @default(uuid())
  partnerId     String
  paymentMethod PaymentMethod
  day           DateTime
  amount        Float          @default(0)
  count         Int            @default(0)

  @@unique([partnerId, paymentMethod, day], name: "partner_method_day_unique")
}

model PartnerUserDailyLimit {
  id            String         @id @default(uuid())
  partnerUserId String
  paymentMethod PaymentMethod
  day           DateTime
  amount        Float          @default(0)
  count         Int            @default(0)

  @@unique([partnerUserId, paymentMethod, day], name: "partner_user_method_day_unique")
}

model PartnerMonthlyLimit {
  id            String         @id @default(uuid())
  partnerId     String
  paymentMethod PaymentMethod
  month         DateTime
  amount        Float          @default(0)
  count         Int            @default(0)

  @@unique([partnerId, paymentMethod, month], name: "partner_method_month_unique")
}

model PartnerUserMonthlyLimit {
  id            String         @id @default(uuid())
  partnerUserId String
  paymentMethod PaymentMethod
  month         DateTime
  amount        Float          @default(0)
  count         Int            @default(0)

  @@unique([partnerUserId, paymentMethod, month], name: "partner_user_method_month_unique")
}

view TransactionQuoteView {
  id                   String
  transactionStatus    TransactionStatus
  partnerUserId        String
  accountNumber        String
  bankCode             String
  transactionCreatedAt DateTime
  quoteId              String
  onChainId            String?
  refundOnChainId      String?
  taxId                String?
  externalId           String?
  qrCode               String?
  partnerId            String
  targetAmount         Float
  sourceAmount         Float
  targetCurrency       TargetCurrency
  paymentMethod        PaymentMethod
  country              Country
  cryptoCurrency       CryptoCurrency
  network              BlockchainNetwork
  expirationDate       DateTime
  quoteCreatedAt       DateTime
  quoteUpdatedAt       DateTime

  @@unique([id])
  @@map("TransactionQuoteView")
}

model FlowDefinition {
  id             String               @id @default(uuid())
  name           String
  enabled        Boolean              @default(true)
  cryptoCurrency CryptoCurrency
  blockchain     BlockchainNetwork
  targetCurrency TargetCurrency
  payoutProvider PaymentMethod
  pricingProvider FlowPricingProvider
  exchangeFeePct Float               @default(0)
  fixedFee       Float               @default(0)
  minAmount      Float?
  maxAmount      Float?
  userSteps      Json
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  steps          FlowStepDefinition[]

  @@unique([cryptoCurrency, blockchain, targetCurrency], name: "flow_corridor_unique")
}

model FlowCorridor {
  id             String             @id @default(uuid())
  cryptoCurrency CryptoCurrency
  blockchain     BlockchainNetwork
  targetCurrency TargetCurrency
  status         FlowCorridorStatus @default(UNSUPPORTED)
  reason         String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([cryptoCurrency, blockchain, targetCurrency], name: "flow_corridor_status_unique")
}

model CryptoAssetConfig {
  id             String            @id @default(uuid())
  cryptoCurrency CryptoCurrency
  blockchain     BlockchainNetwork
  mintAddress    String?
  decimals       Int?
  enabled        Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([cryptoCurrency, blockchain], name: "crypto_asset_unique")
}

model FlowStepDefinition {
  id               String                   @id @default(uuid())
  flowDefinitionId String
  flowDefinition   FlowDefinition           @relation(fields: [flowDefinitionId], references: [id], onDelete: Cascade)
  stepOrder        Int
  stepType         FlowStepType
  completionPolicy FlowStepCompletionPolicy
  config           Json
  signalMatch      Json?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([flowDefinitionId])
  @@unique([flowDefinitionId, stepOrder], name: "flow_step_order_unique")
}

model FlowInstance {
  id             String             @id @default(uuid())
  transactionId  String             @unique
  status         FlowInstanceStatus @default(NOT_STARTED)
  currentStepOrder Int?
  flowSnapshot   Json
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  steps          FlowStepInstance[]
}

model FlowStepInstance {
  id             String        @id @default(uuid())
  flowInstanceId String
  flowInstance   FlowInstance  @relation(fields: [flowInstanceId], references: [id], onDelete: Cascade)
  stepOrder      Int
  stepType       FlowStepType
  status         FlowStepStatus @default(NOT_STARTED)
  attempts       Int           @default(0)
  maxAttempts    Int           @default(3)
  input          Json?
  output         Json?
  error          Json?
  correlation    Json?
  startedAt      DateTime?
  endedAt        DateTime?
  retryAt        DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([flowInstanceId])
  @@index([status, stepType, retryAt], name: "flow_step_retry_due_idx")
  @@unique([flowInstanceId, stepOrder], name: "flow_step_instance_order_unique")
}

model FlowSignal {
  id             String   @id @default(uuid())
  flowInstanceId String?
  stepInstanceId String?
  eventType      String
  correlationKeys Json
  payload        Json
  createdAt      DateTime @default(now())
  consumedAt     DateTime?

  @@index([eventType])
  @@index([consumedAt])
}

enum BridgeLegStatus {
  PENDING
  BATCHED
  SETTLED
  FAILED
}

enum BridgeBatchStatus {
  OPEN
  SUBMITTED
  CREDITED
  FAILED
}

// One per ENQUEUE_BRIDGE step: the USDC a flow deposited at Binance that still
// owes a cross-chain bridge to Transfero. Accumulated across flows and swept to
// Transfero in batches >= the per-withdrawal minimum (the flow itself settles
// immediately by converting against the Transfero float — see ENQUEUE_BRIDGE).
model BridgePendingTransfer {
  id            String          @id @default(uuid())
  transactionId String
  stepOrder     Int
  asset         CryptoCurrency
  destNetwork   String
  amount        Float
  status        BridgeLegStatus @default(PENDING)
  batchId       String?
  batch         BridgeBatch?    @relation(fields: [batchId], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // (transactionId, stepOrder) is the idempotency anchor: re-running the
  // ENQUEUE_BRIDGE step never double-enrolls a leg.
  @@unique([transactionId, stepOrder])
  @@index([asset, destNetwork, status])
  @@index([batchId])
}

// One pooled Binance withdrawal that bridges many BridgePendingTransfer legs.
model BridgeBatch {
  id          String                  @id @default(uuid())
  asset       CryptoCurrency
  destNetwork String
  grossAmount Float
  withdrawFee Float?
  withdrawId  String?
  status      BridgeBatchStatus       @default(OPEN)
  members     BridgePendingTransfer[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  settledAt   DateTime?

  @@index([asset, destNetwork, status])
}

// Point-in-time balance of one (venue, account, currency) cell, captured by the
// treasury snapshot worker. usdRate/usdValue freeze the indicative FX at capture
// time so historical USD charts do not drift when today's rate changes.
model TreasuryBalanceSnapshot {
  id         String   @id @default(uuid())
  venue      String
  account    String   @default("")
  currency   String
  amount     Float
  usdRate    Float?
  usdValue   Float?
  capturedAt DateTime @default(now())

  @@index([venue, currency, capturedAt])
  @@index([capturedAt])
}
