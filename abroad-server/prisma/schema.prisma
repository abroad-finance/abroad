  resolvedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  notes         OpsCaseNote[]
  handoffs      OpsHandoff[]

  @@index([status, priority, updatedAt])
  @@index([ownerUserId, status, updatedAt])
}

model OpsCaseNote {
  id           String      @id @default(uuid())
  caseId       String
  case         OpsCase     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorUserId String
  author       OpsUser     @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  kind         OpsNoteKind @default(NOTE)
  body         String
  createdAt    DateTime    @default(now())

  @@index([caseId, createdAt])
}

model OpsIncident {
  id              String              @id @default(uuid())
  fingerprint     String              @unique
  kind            String
  title           String
  summary         String
  context         Json?
  severity        OpsIncidentSeverity
  status          OpsWorkStatus       @default(OPEN)
  ownerUserId     String?
  owner           OpsUser?            @relation("OpsIncidentOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  team            String?
  runbookId       String?
  runbook         OpsRunbook?         @relation(fields: [runbookId], references: [id], onDelete: SetNull)
  firstSeenAt     DateTime
  lastSeenAt      DateTime
  occurrenceCount Int                 @default(1)
  affectedCount   Int                 @default(0)
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?
  version         Int                 @default(1)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  notes           OpsIncidentNote[]
  handoffs        OpsHandoff[]

  @@index([status, severity, lastSeenAt])
  @@index([ownerUserId, status, lastSeenAt])
  @@index([kind, status, lastSeenAt])
}

model OpsIncidentNote {
  id           String      @id @default(uuid())
  incidentId   String
  incident     OpsIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  authorUserId String
  author       OpsUser     @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  kind         OpsNoteKind @default(NOTE)
  body         String
  createdAt    DateTime    @default(now())

  @@index([incidentId, createdAt])
}

model OpsHandoff {
  id           String              @id @default(uuid())
  resourceType OpsWorkResourceType
  caseId       String?
  case         OpsCase?            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  incidentId   String?
  incident     OpsIncident?        @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actorUserId  String
  actor        OpsUser             @relation("OpsHandoffActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  fromUserId   String?
  fromUser     OpsUser?            @relation("OpsHandoffFrom", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUserId     String?
  toUser       OpsUser?            @relation("OpsHandoffTo", fields: [toUserId], references: [id], onDelete: SetNull)
  fromTeam     String?
  toTeam       String?
  note         String
  createdAt    DateTime            @default(now())

  @@index([caseId, createdAt])
  @@index([incidentId, createdAt])
  @@index([toUserId, createdAt])
}

model OpsRunbook {
  id              String        @id @default(uuid())
  slug            String        @unique
  name            String
  description     String
  url             String
  incidentKinds   String[]
  active          Boolean       @default(true)
  version         Int           @default(1)
  createdByUserId String
  createdBy       OpsUser       @relation("OpsRunbookCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUserId String
  updatedBy       OpsUser       @relation("OpsRunbookUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  incidents       OpsIncident[]

  @@index([active, name])
}

model OpsIntegration {
  id              String               @id @default(uuid())
  name            String               @unique
  kind            OpsIntegrationKind
  status          OpsIntegrationStatus @default(ACTIVE)
  description     String
  configuration   Json
  lastCheckedAt   DateTime?
  lastErrorCode   String?
  version         Int                  @default(1)
  createdByUserId String
  createdBy       OpsUser              @relation("OpsIntegrationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUserId String
  updatedBy       OpsUser              @relation("OpsIntegrationUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([kind, status, name])
}

model OpsTreasuryThreshold {
  id                  String   @id @default(uuid())
  venue               String
  currency            String
  minimumAvailable    Float?
  warningRunwayHours  Float?
  criticalRunwayHours Float?
  ownerTeam           String
  version             Int      @default(1)
  createdByUserId     String
  createdBy           OpsUser  @relation("OpsTreasuryThresholdCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUserId     String
  updatedBy           OpsUser  @relation("OpsTreasuryThresholdUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([venue, currency])
  @@index([ownerTeam, venue, currency])
}

model OpsConfigurationRelease {
  id                String                        @id @default(uuid())
  targetType        OpsConfigurationTargetType
  targetKey         String
  title             String
  baseVersion       Int
  status            OpsConfigurationReleaseStatus @default(DRAFT)
  payload           Json
  diff              Json
  impact            Json
  version           Int                           @default(1)
  reason            String
  reference         String?
  idempotencyKey    String                        @unique
  requestedByUserId String
  requestedBy       OpsUser                       @relation("OpsConfigurationRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  approvedByUserId  String?
  approvedBy        OpsUser?                      @relation("OpsConfigurationApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  appliedByUserId   String?
  appliedBy         OpsUser?                      @relation("OpsConfigurationAppliedBy", fields: [appliedByUserId], references: [id], onDelete: SetNull)
  rollbackOfId      String?
  rollbackOf        OpsConfigurationRelease?      @relation("OpsConfigurationRollback", fields: [rollbackOfId], references: [id], onDelete: SetNull)
  rollbacks         OpsConfigurationRelease[]     @relation("OpsConfigurationRollback")
  rejectionReason   String?
  effectiveAt       DateTime?
  approvedAt        DateTime?
  appliedAt         DateTime?
  appliedVersion    Int?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  @@index([targetType, targetKey, createdAt])
  @@index([status, effectiveAt, createdAt])
}

model OpsTaskEvent {
  id           String        @id @default(uuid())
  actorUserId  String?
  actor        OpsUser?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  task         String
  action       String
  resourceType String?
  resourceId   String?
  result       OpsTaskResult
  durationMs   Int?
  metadata     Json?
  createdAt    DateTime      @default(now())

  @@index([task, action, createdAt])
  @@index([actorUserId, createdAt])
}

model OpsMutationExecution {
  id              String            @id @default(uuid())
  idempotencyKey  String            @unique
  action          String
  status          OpsMutationStatus @default(REQUESTED)
  actorUserId     String
  actor           OpsUser           @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  resourceType    String
  resourceId      String?
  reason          String
  reference       String?
  confirmation    String
  expectedVersion Int?
  failureCode     String?
  requestedAt     DateTime          @default(now())
  completedAt     DateTime?

  @@index([actorUserId, requestedAt])
  @@index([action, status, requestedAt])
  @@index([resourceType, resourceId, requestedAt])
}
