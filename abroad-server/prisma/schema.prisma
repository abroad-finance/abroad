// prisma/schema.prisma
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Partner {
  id                           String    @id @default(uuid())
  name                         String
  createdAt                    DateTime  @default(now())
  apiKey                       String?   @unique
  previousApiKey               String?   @unique
  previousApiKeyExpiresAt      DateTime?
  clientDomain                 String?   @unique
  clientDomainHash             String?   @unique
  publicSignupIdempotencyHash  String?   @unique
  publicSignupOrganizationHash String?   @unique
  country                      String?
  email                        String?   @unique
  phone                        String?
  firstName                    String?
  lastName                     String?
  isKybApproved                Boolean?  @default(false)
  needsKyc                     Boolean?  @default(true)
  webhookUrl                   String?

  // Partner-wide suspension (operator action from the Ops dashboard).
  // disabledAt == null means the partner is active. Blocks every API key and
  // client-domain session for the partner at once.
  disabledAt              DateTime?
  disabledReason          String?
  disabledBy              String?
  users                   PartnerUser[]
  portalUsers             PartnerPortalUser[]
  portalApiKeys           PartnerApiKey[]
  portalAuditEvents       PartnerPortalAuditEvent[]
  aiAuthorizationRequests PartnerAiAuthorizationRequest[]
  aiConnections           PartnerAiConnection[]
  webhookConfiguration    PartnerWebhookConfiguration?
  outboxEvents            OutboxEvent[]
  reconciliationRuns      PartnerReconciliationRun[]
  quotes                  Quote[]
}

model PartnerPortalUser {
  id                          String                                @id @default(uuid())
  partnerId                   String
  partner                     Partner                               @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  email                       String                                @unique
  passwordVerifier            String?
  role                        PartnerPortalRole                     @default(MEMBER)
  sessionVersion              Int                                   @default(1)
  failedLoginAttempts         Int                                   @default(0)
  lockedUntil                 DateTime?
  lastLoginAt                 DateTime?
  disabledAt                  DateTime?
  emailVerificationRequiredAt DateTime?
  emailVerifiedAt             DateTime?
  mfaSecretCiphertext         String?
  mfaPendingSecretCiphertext  String?
  mfaPendingCreatedAt         DateTime?
  mfaEnabledAt                DateTime?
  mfaLastUsedCounter          BigInt?
  mfaFailedAttempts           Int                                   @default(0)
  mfaLockedUntil              DateTime?
  createdAt                   DateTime                              @default(now())
  updatedAt                   DateTime                              @updatedAt
  createdApiKeys              PartnerApiKey[]                       @relation("PartnerApiKeyCreator")
  auditEvents                 PartnerPortalAuditEvent[]             @relation("PartnerPortalAuditActor")
  createdResetTokens          PartnerPortalPasswordResetToken[]     @relation("PartnerPortalPasswordResetCreator")
  resetTokens                 PartnerPortalPasswordResetToken[]     @relation("PartnerPortalPasswordResetSubject")
  emailVerificationTokens     PartnerPortalEmailVerificationToken[]
  mfaRecoveryCodes            PartnerPortalMfaRecoveryCode[]
  initiatedOutboxEvents       OutboxEvent[]                         @relation("OutboxPortalInitiator")
  reconciliationRuns          PartnerReconciliationRun[]            @relation("PartnerReconciliationInitiator")
  aiAuthorizationRequests     PartnerAiAuthorizationRequest[]       @relation("PartnerAiAuthorizationActor")
  authorizedAiConnections     PartnerAiConnection[]                 @relation("PartnerAiConnectionAuthorizer")

  @@index([partnerId])
}

model PartnerApiKey {
  id              String               @id @default(uuid())
  partnerId       String
  partner         Partner              @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  name            String
  secretHash      String               @unique
  displayPrefix   String
  scopes          PartnerApiKeyScope[]
  expiresAt       DateTime?
  revokedAt       DateTime?
  lastUsedAt      DateTime?
  createdByUserId String
  createdBy       PartnerPortalUser    @relation("PartnerApiKeyCreator", fields: [createdByUserId], references: [id])
  rotatedFromId   String?              @unique
  rotatedFrom     PartnerApiKey?       @relation("PartnerApiKeyRotation", fields: [rotatedFromId], references: [id], onDelete: SetNull)
  rotatedTo       PartnerApiKey?       @relation("PartnerApiKeyRotation")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([partnerId, revokedAt, expiresAt])
}

model PartnerWebhookConfiguration {
  partnerId               String    @id
  partner                 Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  activeSecretCiphertext  String?
  activeSecretPrefix      String?
  activeSecretVersion     Int       @default(0)
  pendingUrl              String?
  pendingSecretCiphertext String?
  pendingSecretPrefix     String?
  pendingRevision         Int       @default(0)
  lastTestedRevision      Int?
  lastTestedAt            DateTime?
  lastTestSucceeded       Boolean?
  lastTestHttpStatus      Int?
  lastTestDurationMs      Int?
  lastTestFailureCode     String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model PartnerPortalMfaRecoveryCode {
  id         String            @id @default(uuid())
  userId     String
  user       PartnerPortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String            @unique
  consumedAt DateTime?
  createdAt  DateTime          @default(now())

  @@index([userId, consumedAt])
}

model PartnerPortalPasswordResetToken {
  id              String                            @id @default(uuid())
  userId          String
  user            PartnerPortalUser                 @relation("PartnerPortalPasswordResetSubject", fields: [userId], references: [id], onDelete: Cascade)
  createdByUserId String?
  createdBy       PartnerPortalUser?                @relation("PartnerPortalPasswordResetCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  tokenHash       String                            @unique
  purpose         PartnerPortalPasswordResetPurpose
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime                          @default(now())

  @@index([userId, expiresAt])
}

model PartnerPortalEmailVerificationToken {
  id                      String                           @id @default(uuid())
  userId                  String
  user                    PartnerPortalUser                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash               String                           @unique
  tokenCiphertext         String?
  expiresAt               DateTime
  consumedAt              DateTime?
  sentAt                  DateTime?
  deliveredAt             DateTime?
  providerMessageId       String?                          @unique
  deliveryStatus          PartnerPortalEmailDeliveryStatus @default(PENDING)
  deliveryAttemptCount    Int                              @default(0)
  lastDeliveryAttemptAt   DateTime?
  deliveryFailureCode     String?
  deliveryStatusUpdatedAt DateTime                         @default(now())
  createdAt               DateTime                         @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt, consumedAt])
  @@index([deliveryStatus, createdAt])
}

enum PartnerPortalEmailDeliveryStatus {
  PENDING
  ACCEPTED
  DELAYED
  DELIVERED
  BOUNCED
  COMPLAINED
  FAILED
  SUPPRESSED
  UNAVAILABLE
}

model PartnerPortalEmailWebhookEvent {
  id                String    @id
  providerMessageId String
  eventType         String
  occurredAt        DateTime
  processedAt       DateTime?
  receivedAt        DateTime  @default(now())

  @@index([providerMessageId, occurredAt])
  @@index([processedAt, receivedAt])
}

model PartnerPortalPublicRateLimit {
  keyHash      String   @id
  attempts     Int
  windowEndsAt DateTime
  updatedAt    DateTime @updatedAt

  @@index([windowEndsAt])
}

model PartnerPortalAuditEvent {
  id           String             @id @default(uuid())
  partnerId    String
  partner      Partner            @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  actorUserId  String?
  actor        PartnerPortalUser? @relation("PartnerPortalAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  createdAt    DateTime           @default(now())

  @@index([partnerId, createdAt])
}

model PartnerAiOAuthClient {
  id                    String                          @id @default(uuid())
  clientId              String                          @unique
  clientName            String
  redirectUris          String[]
  allowedScopes         PartnerAiScope[]
  clientUri             String?
  verifiedKind          PartnerAiClientKind             @default(GENERIC)
  disabledAt            DateTime?
  lastUsedAt            DateTime?
  createdAt             DateTime                        @default(now())
  updatedAt             DateTime                        @updatedAt
  authorizationRequests PartnerAiAuthorizationRequest[]
  connections           PartnerAiConnection[]

  @@index([disabledAt, createdAt])
}

model PartnerAiAuthorizationRequest {
  id              String                        @id @default(uuid())
  oauthClientId   String
  oauthClient     PartnerAiOAuthClient          @relation(fields: [oauthClientId], references: [id], onDelete: Restrict)
  redirectUri     String
  stateCiphertext String?
  scopes          PartnerAiScope[]
  resource        String
  codeChallenge   String
  fingerprintHash String                        @unique
  expiresAt       DateTime
  outcome         PartnerAiAuthorizationOutcome @default(PENDING)
  resolvedAt      DateTime?
  partnerId       String?
  partner         Partner?                      @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  actorUserId     String?
  actor           PartnerPortalUser?            @relation("PartnerAiAuthorizationActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  connectionId    String?                       @unique
  connection      PartnerAiConnection?          @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  codeHash        String?                       @unique
  codeExpiresAt   DateTime?
  codeConsumedAt  DateTime?
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt

  @@index([oauthClientId, expiresAt, outcome])
  @@index([partnerId, createdAt])
}

model PartnerAiConnection {
  id                   String                         @id @default(uuid())
  partnerId            String
  partner              Partner                        @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  oauthClientId        String
  oauthClient          PartnerAiOAuthClient           @relation(fields: [oauthClientId], references: [id], onDelete: Restrict)
  authorizedByUserId   String?
  authorizedBy         PartnerPortalUser?             @relation("PartnerAiConnectionAuthorizer", fields: [authorizedByUserId], references: [id], onDelete: SetNull)
  scopes               PartnerAiScope[]
  activeGrantKey       String?                        @unique
  authorizedAt         DateTime                       @default(now())
  expiresAt            DateTime
  lastUsedAt           DateTime?
  lastTestedAt         DateTime?
  revokedAt            DateTime?
  failedAt             DateTime?
  failureCode          String?
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
  authorizationRequest PartnerAiAuthorizationRequest?
  accessTokens         PartnerAiAccessToken[]
  refreshTokens        PartnerAiRefreshToken[]

  @@index([partnerId, createdAt])
  @@index([oauthClientId, createdAt])
  @@index([partnerId, revokedAt, failedAt, expiresAt])
}

model PartnerAiAccessToken {
  id           String              @id @default(uuid())
  connectionId String
  connection   PartnerAiConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  tokenHash    String              @unique
  scopes       PartnerAiScope[]
  expiresAt    DateTime
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime            @default(now())

  @@index([connectionId, expiresAt, revokedAt])
}

model PartnerAiRefreshToken {
  id           String                 @id @default(uuid())
  connectionId String
  connection   PartnerAiConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  tokenHash    String                 @unique
  familyId     String
  scopes       PartnerAiScope[]
  expiresAt    DateTime
  consumedAt   DateTime?
  revokedAt    DateTime?
  replacedById String?                @unique
  replacedBy   PartnerAiRefreshToken? @relation("PartnerAiRefreshRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     PartnerAiRefreshToken? @relation("PartnerAiRefreshRotation")
  createdAt    DateTime               @default(now())

  @@index([connectionId, expiresAt, revokedAt])
  @@index([familyId, createdAt])
}

model PartnerUser {
  id               String           @id @default(uuid())
  partnerId        String
  partner          Partner          @relation(fields: [partnerId], references: [id])
  userId           String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  transaction      Transaction[]
  kyc              PartnerUserKyc[]
  kycExternalToken String?

  // Account disable/enable (operator action from the Ops dashboard).
  // disabledAt == null means the user is enabled.
  disabledAt     DateTime?
  disabledReason String?
  disabledBy     String?

  // Unique constraint to ensure a user is only once per partner
  @@unique([partnerId, userId])
}

model PartnerUserKyc {
  id            String      @id @default(uuid())
  partnerUser   PartnerUser @relation(fields: [partnerUserId], references: [id])
  partnerUserId String

  status KycStatus @default(PENDING)

  // Self-service KYC form fields (auto-approved on complete submission).
  fullName          String?
  documentType      DocumentType?
  documentNumber    String?
  documentImagePath String? // GCS object key for the uploaded ID image
  dateOfBirth       DateTime?
  nationality       String?
  city              String?
  address           String?
  email             String?
  phone             String?
  reviewedAt        DateTime?
  opsReviewerUserId String?
  opsReviewer       OpsUser?      @relation("OpsKycReviewer", fields: [opsReviewerUserId], references: [id], onDelete: SetNull)
  opsReviewVersion  Int           @default(1)

  // Deprecated Persona fields (kept nullable for historical rows; no longer written).
  externalId String?
  tier       KYCTier @default(NONE)
  link       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([partnerUserId, externalId])
  @@index([opsReviewerUserId, status, createdAt])
}

model Quote {
  id                        String            @id @default(uuid())
  targetAmount              Float
  sourceAmount              Float
  targetCurrency            TargetCurrency
  paymentMethod             PaymentMethod
  country                   Country
  cryptoCurrency            CryptoCurrency
  network                   BlockchainNetwork
  direction                 FlowDirection     @default(CRYPTO_TO_FIAT)
  baseRateSourcePerTarget   Decimal?          @db.Decimal(36, 18)
  exchangeFeePct            Decimal?          @db.Decimal(18, 12)
  fixedFeeTargetAmount      Decimal?          @db.Decimal(36, 18)
  customerFeeSourceAmount   Decimal?          @db.Decimal(36, 18)
  customerFeeSourceCurrency CryptoCurrency?
  customerFeeType           CustomerFeeType?

  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id])

  expirationDate DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  transaction    Transaction?

  @@index([partnerId])
  @@index([createdAt])
}

model Transaction {
  id                  String                      @id @default(uuid())
  partnerUserId       String
  partnerUser         PartnerUser                 @relation(fields: [partnerUserId], references: [id])
  // Fiat destination. Populated for CRYPTO_TO_FIAT payouts; empty on
  // FIAT_TO_CRYPTO, where destinationAddress carries the destination instead.
  accountNumber       String                      @default("")
  bankCode            String                      @default("")
  // On-chain destination for FIAT_TO_CRYPTO deliveries. Null on payouts.
  destinationAddress  String?
  status              TransactionStatus
  createdAt           DateTime                    @default(now())
  quoteId             String                      @unique
  quote               Quote                       @relation(fields: [quoteId], references: [id])
  // On a payout this is the customer's inbound deposit. On an onramp it is our
  // outbound delivery to destinationAddress, and it is set ONLY once that
  // delivery is confirmed on chain. A prepared-but-unconfirmed hash lives on
  // DeliveryAttempt: writing one here made the executor's "already delivered"
  // short-circuit report success for a transaction that never landed.
  onChainId           String?                     @unique
  refundOnChainId     String?                     @unique
  pixEndToEndId       String?                     @unique
  // Ultra deposit id backing a FIAT_TO_CRYPTO transaction's dynamic QR. Unique
  // so a replayed pix.deposit.* delivery can never credit two transactions.
  pixDepositId        String?                     @unique
  // CPF/CNPJ the incoming PIX was actually paid from. Recorded for
  // reconciliation; the payer is not required to be the recipient.
  pixPayerTaxId       String?
  taxId               String?
  externalId          String?                     @unique
  // On a payout this is the PIX QR we pay. On an onramp it is the BR Code the
  // customer pays.
  qrCode              String?
  exchangeHandoffAt   DateTime?
  origin              TransactionOrigin           @default(LEGACY)
  transitions         TransactionTransition[]
  outboxEvents        OutboxEvent[]
  reconciliationItems PartnerReconciliationItem[]
  opsCase             OpsCase?
  economics           TransactionEconomics?
  refundRecovery      RefundRecovery?
  deliveryAttempts    DeliveryAttempt[]

  @@index([partnerUserId, status, createdAt], name: "transaction_partnerUser_status_createdAt_idx")
  @@index([createdAt, status], name: "transaction_createdAt_status_idx")
}

/**
 * One attempt at delivering crypto to a FIAT_TO_CRYPTO customer.
 * The signed envelope and its expiry are kept so a submission that timed out
 * can be resolved without guesswork: past `expiresAt` the transaction can
 * never be included, so an attempt still unconfirmed then is provably dead and
 * the next attempt is safe. Re-submitting the stored envelope is equally safe,
 * since it carries the same hash and cannot pay twice.
 * This mirrors RefundRecoveryAttempt, which gives refunds the same guarantee.
 */
model DeliveryAttempt {
  id                String                @id @default(uuid())
  transactionId     String
  transaction       Transaction           @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  attemptNumber     Int
  transactionHash   String                @unique
  signedEnvelopeXdr String?               @db.Text
  amount            Decimal               @db.Decimal(36, 18)
  asset             CryptoCurrency
  network           BlockchainNetwork
  feeStroops        BigInt?
  status            DeliveryAttemptStatus @default(PREPARED)
  failureCode       String?
  expiresAt         DateTime
  preparedAt        DateTime              @default(now())
  submittedAt       DateTime?
  lastReconciledAt  DateTime?
  confirmedAt       DateTime?

  @@unique([transactionId, attemptNumber])
  @@index([status, expiresAt])
  @@index([transactionId, status])
}

enum DeliveryAttemptStatus {
  PREPARED
  SUBMITTED
  CONFIRMED
  EXPIRED
  FAILED
}

model StellarListenerState {
  id              String   @id @default("singleton")
  lastPagingToken String
  updatedAt       DateTime @updatedAt
}

model SolanaListenerState {
  id                String    @id
  lastSignature     String?
  lastProcessedTime DateTime?
  lastProcessedSlot Int
}

model StellarOrphanRefund {
  paymentId           String             @id
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  lastError           String?
  reason              String?
  refundTransactionId String?
  status              OrphanRefundStatus
}

model RefundRecovery {
  id                    String                      @id @default(uuid())
  transactionId         String                      @unique
  transaction           Transaction                 @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  status                RefundRecoveryStatus        @default(NEEDS_RECONCILIATION)
  version               Int                         @default(1)
  originalRefundHash    String?                     @unique
  originalHashExpiresAt DateTime?
  lastResult            RefundReconciliationResult?
  lastFailureCode       String?
  lastReconciledAt      DateTime?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  attempts              RefundRecoveryAttempt[]

  @@index([status, updatedAt])
}

model RefundRecoveryAttempt {
  id                   String                      @id @default(uuid())
  recoveryId           String
  recovery             RefundRecovery              @relation(fields: [recoveryId], references: [id], onDelete: Cascade)
  attemptNumber        Int
  operationKey         String                      @unique
  transactionHash      String                      @unique
  signedEnvelopeXdr    String                      @db.Text
  amount               Decimal                     @db.Decimal(36, 18)
  asset                CryptoCurrency
  network              BlockchainNetwork
  status               RefundRecoveryAttemptStatus @default(PREPARED)
  failureCode          String?
  expiresAt            DateTime
  preparedAt           DateTime                    @default(now())
  submittedAt          DateTime?
  lastReconciledAt     DateTime?
  completedAt          DateTime?
  initiatedByOpsUserId String?
  initiatedByOpsUser   OpsUser?                    @relation(fields: [initiatedByOpsUserId], references: [id], onDelete: SetNull)

  @@unique([recoveryId, attemptNumber])
  @@index([recoveryId, status, preparedAt])
  @@index([initiatedByOpsUserId, preparedAt])
}

model PendingConversions {
  source SupportedCurrency
  target SupportedCurrency
  amount Float
  symbol String
  side   OrderSide

  @@id([source, target])
}

model TransactionTransition {
  id             String            @id @default(uuid())
  transactionId  String
  transaction    Transaction       @relation(fields: [transactionId], references: [id])
  event          String
  fromStatus     TransactionStatus
  toStatus       TransactionStatus
  idempotencyKey String
  context        Json?
  createdAt      DateTime          @default(now())

  @@unique([transactionId, idempotencyKey])
  @@index([transactionId, createdAt])
}

enum OutboxStatus {
  PENDING
  DELIVERING
  DELIVERED
  FAILED
}

model OutboxEvent {
  id                      String                  @id @default(uuid())
  type                    String
  payload                 Json
  status                  OutboxStatus            @default(PENDING)
  attempts                Int                     @default(0)
  lastError               String?
  partnerId               String?
  partner                 Partner?                @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  transactionId           String?
  transaction             Transaction?            @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  webhookEvent            String?
  webhookPurpose          WebhookDeliveryPurpose?
  webhookCredentialMode   WebhookCredentialMode?
  sourceOutboxEventId     String?
  sourceOutboxEvent       OutboxEvent?            @relation("OutboxRedeliveries", fields: [sourceOutboxEventId], references: [id], onDelete: SetNull)
  redeliveries            OutboxEvent[]           @relation("OutboxRedeliveries")
  initiatedByPortalUserId String?
  initiatedByPortalUser   PartnerPortalUser?      @relation("OutboxPortalInitiator", fields: [initiatedByPortalUserId], references: [id], onDelete: SetNull)
  idempotencyKey          String?                 @unique
  maxAttempts             Int                     @default(5)
  lastHttpStatus          Int?
  lastAttemptDurationMs   Int?
  availableAt             DateTime                @default(now())
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@index([status, availableAt])
  @@index([partnerId, transactionId, createdAt])
  @@index([sourceOutboxEventId, createdAt])
}

model PartnerReconciliationRun {
  id                      String                         @id @default(uuid())
  partnerId               String
  partner                 Partner                        @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  initiatedByPortalUserId String
  initiatedByPortalUser   PartnerPortalUser              @relation("PartnerReconciliationInitiator", fields: [initiatedByPortalUserId], references: [id])
  status                  PartnerReconciliationRunStatus @default(RUNNING)
  batchSize               Int
  cursorCreatedAt         DateTime?
  cursorTransactionId     String?
  leaseToken              String?
  leaseExpiresAt          DateTime?
  processedCount          Int                            @default(0)
  updatedCount            Int                            @default(0)
  unchangedCount          Int                            @default(0)
  ineligibleCount         Int                            @default(0)
  failureCount            Int                            @default(0)
  completedAt             DateTime?
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt
  items                   PartnerReconciliationItem[]

  @@index([partnerId, createdAt])
}

model PartnerReconciliationItem {
  id            String                          @id @default(uuid())
  runId         String
  run           PartnerReconciliationRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  transactionId String
  transaction   Transaction                     @relation(fields: [transactionId], references: [id])
  status        PartnerReconciliationItemStatus
  failureCode   String?
  createdAt     DateTime                        @default(now())
  updatedAt     DateTime                        @updatedAt

  @@unique([runId, transactionId])
  @@index([transactionId])
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
  PENDING_APPROVAL
}

enum PartnerPortalRole {
  ADMIN
  MEMBER
}

enum PartnerAiClientKind {
  GENERIC
}

enum PartnerAiScope {
  ACCOUNT_READ
  DOCS_READ
  REQUESTS_VALIDATE
  TRANSACTIONS_READ
  WEBHOOKS_READ
  OFFLINE_ACCESS
}

enum PartnerAiAuthorizationOutcome {
  PENDING
  APPROVED
  DENIED
  EXPIRED
}

enum PartnerApiKeyScope {
  TRANSACTIONS_READ
  TRANSACTIONS_WRITE
  PARTNER_USERS_READ
  PARTNER_USERS_WRITE
  KYC_READ
  KYC_WRITE
  TELEMETRY_WRITE
}

enum PartnerPortalPasswordResetPurpose {
  INVITATION
  PASSWORD_RESET
}

enum WebhookDeliveryPurpose {
  TRANSACTION
  TEST
  REDELIVERY
}

enum WebhookCredentialMode {
  PARTNER_CURRENT
  PARTNER_PENDING
  LEGACY_ORIGIN
}

enum PartnerReconciliationRunStatus {
  RUNNING
  COMPLETED
  COMPLETED_WITH_ERRORS
}

enum PartnerReconciliationItemStatus {
  UPDATED
  UNCHANGED
  INELIGIBLE
  FAILED
}

enum DocumentType {
  NATIONAL_ID
  PASSPORT
  DRIVERS_LICENSE
  FOREIGN_ID
  OTHER
}

enum TransactionStatus {
  AWAITING_PAYMENT
  PROCESSING_PAYMENT
  PAYMENT_FAILED
  PAYMENT_EXPIRED
  PAYMENT_COMPLETED
  WRONG_AMOUNT
}

enum TransactionOrigin {
  DIRECT
  SEP_24
  LEGACY
}

enum OrderSide {
  BUY
  SELL
}

enum OrphanRefundStatus {
  PENDING
  FAILED
  SUCCEEDED
}

enum RefundRecoveryStatus {
  NEEDS_RECONCILIATION
  ELIGIBLE
  AMBIGUOUS
  IN_FLIGHT
  COMPLETED
  BLOCKED
}

